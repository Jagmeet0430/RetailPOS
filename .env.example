# Application
NODE_ENV=development
APP_NAME=RetailPOS
APP_ENV=development
APP_DEBUG=true

# API
API_PORT=3000
API_BASE_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/retailpos

# Security
JWT_SECRET_KEY=change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
